# LLM for Crew agents: anthropic (HTTP API) or claude_code (`claude -p`). If unset: API when
# ANTHROPIC_API_KEY is set, otherwise Claude Code CLI.
ARVO_LLM_BACKEND=
# Optional label for logs when using claude_code (does not switch the CLI model)
ARVO_CLAUDE_CODE_MODEL_LABEL=claude-code-cli
# Timeout (seconds) for each agent LLM subprocess when using claude_code (falls back to
# NOTION_CLAUDE_DELEGATE_TIMEOUT_SEC, else default 3600 in ClaudeCodeLLM). Raise for long SRS / replay.
ARVO_CREWAI_CLAUDE_CODE_TIMEOUT_SEC=
# Approximate context window reported to CrewAI in claude_code mode (default 200000)
ARVO_CLAUDE_CODE_CONTEXT_WINDOW=

# Required only when ARVO_LLM_BACKEND=anthropic (or when ANTHROPIC_API_KEY is set and backend is not forced to claude_code)
ANTHROPIC_API_KEY=

# Default model for all agents (override per agent in YAML if needed)
MODEL=anthropic/claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=8192

# Optional: absolute path to second-brain repo. If unset, ../second-brain next to this project is used.
ARVO_SECOND_BRAIN_ROOT=

# Optional defaults for `crewai run` / main.py when not using JSON trigger
ARVO_INITIATIVE=NEW-000-example
ARVO_INITIATIVE_BRIEF=Goals and optional KB paths to read, e.g. plans/backend/foo/plano.md

# Set to 1 in CI or restricted HOME environments so CrewAI SQLite lives under .crewai_runtime_home/
ARVO_CREWAI_IN_PROJECT_HOME=

# SRS workflow (uv run run_srs) — see README
# Notion reads: use NOTION_API_KEY (REST), OR leave it unset to delegate reads to Claude Code CLI (MCP)
NOTION_API_KEY=
NOTION_PAGE_IDS=
# 1/true/yes = always use Claude CLI for reads even if NOTION_API_KEY is set. 0/false/no = never use CLI (requires API key).
NOTION_VIA_CLAUDE_CODE=
# Working directory for `claude -p` (MCP discovery); default = parent of arvo_auth_orchestrator if arvo-auth/second-brain exist
ARVO_CLAUDE_CODE_CWD=
CLAUDE_CODE_BIN=
# Optional: claude -p permission mode (default acceptEdits in code if unset). dontAsk blocks Write tool — breaks flows that try to write files from the CLI subprocess.
CLAUDE_CODE_PERMISSION_MODE=acceptEdits
NOTION_CLAUDE_DELEGATE_TIMEOUT_SEC=600
# Optional: extra args for claude, e.g. --model sonnet
CLAUDE_CODE_EXTRA_ARGS=

ARVO_SRS_PROJECT_NAME=Arvo authorization
ARVO_SRS_PHASE=
# Product overview: inline text or path to .md
ARVO_SRS_PRODUCT_OVERVIEW=
ARVO_SRS_OVERVIEW_FILE=
# Optional extra markdown appended to the overview (paths, hints)
ARVO_SRS_BRIEFING_MARKDOWN=
ARVO_SRS_RULES_FILE=
# Optional: task UUID for `uv run run_srs_replay` (from `crewai log-tasks-outputs`, author_srs_task row)
ARVO_SRS_REPLAY_TASK_ID=

ARVO_BACKEND_REPO_ROOT=
ARVO_FRONTEND_REPO_ROOT=
ARVO_INFRA_REPO_ROOT=

# Frontend branch mapping (uv run run_frontend_branch_mapping) — requires `gh auth login`
ARVO_FRONTEND_GITHUB_REPO=
ARVO_BRANCH_BASE=dev
ARVO_BRANCH_HEAD=
ARVO_BRANCH_MAPPING_TITLE=

# SRS -> Notion publish (uv run run_notion_publish) — Claude Code + MCP (no Notion API token required)
# Parent for new pages: UUID and/or full Notion URL
NOTION_SRS_PARENT_PAGE_ID=
NOTION_SRS_PARENT_URL=
NOTION_PUBLISH_CLAUDE_TIMEOUT_SEC=1800
# Step C — completeness audit subprocess (claude -p + MCP); default 3600 in tool if unset
NOTION_PUBLISH_VERIFY_CLAUDE_TIMEOUT_SEC=
# Optional: absolute or relative path to SRS.md (default outputs/srs_workflow/SRS.md)
ARVO_SRS_PUBLISH_INPUT=

# Notion gap / conflict clarification comments (uv run run_notion_gap_comments) — REST API
# Integration must have search + insert comment capabilities (developer portal).
ARVO_GAP_COMMENT_MAX_ITEMS=15
ARVO_GAP_COMMENT_DRY_RUN=
ARVO_GAP_COMMENT_SOURCES_HINT=

# SRS meeting update — plan only (uv run run_srs_meeting_update): transcript file + full Notion
# tree (MCP) comment scan + diff. No local SRS/publish/gaps inputs in the plan crew. Apply phase
# is separate: uv run run_srs_meeting_update_apply
ARVO_MEETING_TRANSCRIPT_FILE=
# Optional: force the next SRS version in the diff header (e.g. 1.4.0). Empty = derive from manifest.
ARVO_MEETING_UPDATE_NEXT_VERSION=
# Subprocess timeout for notion_collect_srs_page_comments_via_claude (default 3600).
NOTION_COMMENT_SCAN_CLAUDE_TIMEOUT_SEC=
# Timeouts for MCP subprocesses on the apply entry point (uv run run_srs_meeting_update_apply).
# Same timeout applies to uv run run_srs_notion_diff_apply (single apply subprocess).
NOTION_APPLY_CHANGES_CLAUDE_TIMEOUT_SEC=1800
NOTION_VERSIONS_UPDATE_CLAUDE_TIMEOUT_SEC=600
